# Copy this file to .env in the deployment directory and fill in the values.
# Keep .env private; it contains credentials.

# Required: nhentai API authentication
NF_NHENTAI_API_KEY=

# Output
# Keep this equal to the container target in compose.example.yaml.
NF_LIBRARY_DIR=/nhentai

# Optional: add the daily search batch as a Komga Read List, ordered by search rank.
NF_KOMGA_READ_LIST=false

# Optional: Bark notifications
# Leave both URL and device key empty to disable Bark.
NF_BARK_BASE_URL=
NF_BARK_DEVICE_KEY=
NF_BARK_SOUND=healthnotification
