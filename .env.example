# Optional overrides for source-repo compose usage.
# You can run `docker compose` without this file.
# Keep only the values that are commonly changed locally.

# =========================
# Common local overrides
# =========================
TZ=Asia/Shanghai
NFETCHER_USER=1000:1000
SCHEDULE_CRON=30 17 * * *
RETENTION_DAYS=7
GALLERY_CONCURRENCY=3
DETAIL_CONCURRENCY=5
PAGE_CONCURRENCY=4
REQUEST_RPS=4
REQUEST_BURST=8

# =========================
# Build-time proxy
# Leave empty if not needed.
# If your proxy runs on the host machine, prefer:
# http://host.docker.internal:17890
# =========================
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=

# =========================
# Runtime proxy
# Leave empty if not needed.
# If your proxy runs on the host machine, prefer:
# http://host.docker.internal:17890
# =========================
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
